{
  "name": "tokenizer",
  "version": "2.3",
  "packageManager": "bun@1.3.14",
  "module": "src/index.js",
  "scripts": {
    "build": "bun build ./src/index.js --target bun --outdir ./build --external playwright-core",
    "dev": "bun run --watch ./src/index.js",
    "format": "bunx --bun prettier --check .",
    "format:fix": "bunx --bun prettier --check . --write",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx --bun eslint . --fix",
    "migration:run": "bun ./src/migrate.js",
    "migration:down": "bun ./src/migrate.js --down",
    "prepare": "bunx --bun husky",
    "proxy": "cloudflared tunnel run dev",
    "start": "bun run ./src/index.js",
    "test": "bun test",
    "test:ci": "bun test"
  },
  "lint-staged": {
    "*": "prettier --check . --write",
    "*.js": "eslint --fix"
  },
  "dependencies": {
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "dayjs": "^1.11.23",
    "elysia": "^1.4.30",
    "kysely": "^0.29.6",
    "kysely-postgres-js": "^5.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
