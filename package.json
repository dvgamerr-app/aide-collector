{
  "name": "tokenizer",
  "version": "2.3",
  "packageManager": "bun@1.3.14",
  "module": "src/index.js",
  "scripts": {
    "prepare": "husky",
    "proxy": "cloudflared tunnel run dev",
    "dev": "bun run --watch ./src/index.js | bun x pino-pretty",
    "start": "bun run ./src/index.js",
    "migration:run": "bun ./src/migrate.js",
    "migration:down": "bun ./src/migrate.js --down",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --check . --write"
  },
  "lint-staged": {
    "*": "prettier --check . --write",
    "*.js": "eslint --fix"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "dayjs": "^1.11.21",
    "elysia": "^1.4.29",
    "kysely": "^0.29.4",
    "kysely-postgres-js": "^3.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6"
  }
}
