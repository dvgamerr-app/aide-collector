{
  "name": "tokenizer",
  "version": "2.3",
  "packageManager": "bun@1.3.14",
  "module": "src/index.js",
  "scripts": {
    "build": "bun build ./src/index.js --target bun --outdir ./build --external playwright-core",
    "dev": "bun run --watch ./src/index.js",
    "format": "bunx --bun prettier --check .",
    "format:fix": "bunx --bun prettier --check . --write",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx --bun eslint . --fix",
    "migration:run": "bun ./src/migrate.js",
    "migration:down": "bun ./src/migrate.js --down",
    "prepare": "bunx --bun husky",
    "proxy": "cloudflared tunnel run dev",
    "start": "bun run ./src/index.js",
    "test": "bun test"
  },
  "lint-staged": {
    "*": "prettier --check . --write",
    "*.js": "eslint --fix"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "dayjs": "^1.11.23",
    "elysia": "^1.4.30",
    "kysely": "^0.29.6",
    "kysely-postgres-js": "^5.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
