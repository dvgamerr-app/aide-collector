# Single Postgres connection for the API
DATABASE_URL=postgres://postgres@localhost:5432/collector
# Read-only source of GET /v1/coding, /v1/coding/days and /v1/telemetry; those endpoints answer 503 while it is empty.
DATABASE_WAKATIME_URL=postgres://postgres@localhost:5432/wakatime
# PATCH /stash/github (repositories, languages, commits, LOC); needs read access to private repositories for the counts.

# dvgamerr
GH_USER_TOKEN=
# dvgamerr-app
GH_APP_TOKEN=
# scg-wedo
GH_OURKK_TOKEN=
GH_WORK_TOKEN=


MEA_PAYLOAD=payload
MWA_PAYLOAD=payload
SOLAR_DEVICE_ID=
SOLAR_OPEN_APP_ID=
SOLAR_OPEN_APP_SECRET=
SOLAR_PAYLOAD=
PORT=3000
LOG_LEVEL=info

# ONT collection (PATCH /stash/ont); Chrome session is reused between cron calls.
ONT_ID=main
ONT_BASE=http://10.203.1.1
ONT_USER=admin
ONT_PASS=
ONT_MIN_INTERVAL=60
ONT_REQUEST_TIMEOUT=15
# Docker defaults to /usr/bin/chromium; Windows defaults to the installed Google Chrome.
# CHROME_PATH=/usr/bin/chromium
AG_BASE=http://10.203.1.91:8080
AG_USER=dvgamerr
# Empty disables AdGuard enrichment.
AG_PASS=
AG_CLIENT_INTERVAL=900

# Push messages through the notice-manager LINE bot (https://notice.dvgamerr.app); POST /notify/cinema needs both.
NOTIFY_BASE=https://notice.dvgamerr.app
NOTIFY_API_KEY=
NOTIFY_CINEMA_CHAT=

# Traceway tracing over OpenTelemetry (OTLP/HTTP); disabled while the token is empty.
TRACEWAY_URL=http://traceway.local
TRACEWAY_TOKEN=
